# Dockerfile.postgres-backend — Registry image with Postgres-backend deps.
#
# Extends the upstream multi-stage build in docker/Dockerfile.registry by
# layering asyncpg + pgvector-python + psycopg + alembic into the backend
# build venv. The runtime stage is identical to upstream (same nginx + uv
# venv + appuser layout) so review surface stays minimal.
#
# Build:
#   docker build -f Dockerfile.postgres-backend -t mcp-registry:postgres .
#
# Toggle on at runtime via STORAGE_BACKEND=postgres + POSTGRES_DSN.
# See docs/postgres-backend-deploy.md for the operator runbook.

# ===== FRONTEND BUILD STAGE =====
FROM node:20-slim AS frontend-builder

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --legacy-peer-deps

COPY frontend/ ./
RUN npm run build

# ===== BACKEND BUILD STAGE =====
FROM python:3.14-slim AS backend-builder

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# build-essential is needed for asyncpg's optional C extension.
# libpq-dev is needed by psycopg[c] (alembic offline-mode rendering uses
# psycopg as the dialect driver — even though runtime queries go through
# asyncpg, alembic's autogenerate paths still import psycopg).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ca-certificates \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir uv && \
    uv venv .venv --python 3.14

# CPU-only torch first (large, rarely changes — same as upstream).
RUN . .venv/bin/activate && \
    uv pip install --index-url https://download.pytorch.org/whl/cpu \
    "torch>=2.0.0" \
    "torchvision"

# Install upstream pyproject.toml deps.
COPY pyproject.toml /app/pyproject.toml
RUN . .venv/bin/activate && \
    uv pip install --requirement pyproject.toml

# Postgres-backend extras. Pinned to floors that match the asyncpg pool +
# pgvector codec contract documented in
# docs/postgres-backend-design/D-connection-mgmt.md and
# registry/repositories/postgres/client.py.
RUN . .venv/bin/activate && \
    uv pip install \
        "asyncpg>=0.29.0" \
        "pgvector>=0.3.0" \
        "psycopg[binary]>=3.2.0" \
        "alembic>=1.13.0" \
        "SQLAlchemy>=2.0.0"

# Application source — mirrors docker/Dockerfile.registry.
COPY registry/ /app/registry/
COPY auth_server/ /app/auth_server/
COPY api/ /app/api/
COPY scripts/ /app/scripts/
COPY cli/examples/ /app/cli/examples/
# Alembic migration tree — only needed when STORAGE_BACKEND=postgres.
COPY alembic.ini /app/alembic.ini
COPY alembic/ /app/alembic/
COPY migrations/postgres/ /app/migrations/postgres/

RUN . .venv/bin/activate && uv pip install -e .

RUN mkdir -p /app/config && cp /app/auth_server/scopes.yml /app/config/scopes.yml

# ===== FINAL RUNTIME STAGE =====
FROM python:3.14-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

ARG BUILD_VERSION="1.0.0"

# libpq5 is required at runtime by psycopg[binary] only as a fallback;
# kept here so `alembic upgrade head` works in the runtime image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    nginx-extras \
    lua-cjson \
    curl \
    procps \
    openssl \
    ca-certificates \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN groupadd -g 1000 appuser && useradd -u 1000 -g appuser appuser

COPY --from=backend-builder --chown=appuser:appuser /app/.venv /app/.venv
COPY --from=backend-builder --chown=appuser:appuser /app/pyproject.toml /app/pyproject.toml

COPY --chown=appuser:appuser docker/nginx_rev_proxy_http_only.conf /app/docker/nginx_rev_proxy_http_only.conf
COPY --chown=appuser:appuser docker/nginx_rev_proxy_http_and_https.conf /app/docker/nginx_rev_proxy_http_and_https.conf
COPY --chown=appuser:appuser docker/lua/ /app/docker/lua/

COPY --chown=appuser:appuser docker/registry-entrypoint.sh /app/registry-entrypoint.sh
RUN chmod +x /app/registry-entrypoint.sh

COPY --from=backend-builder --chown=appuser:appuser /app/registry /app/registry
COPY --from=backend-builder --chown=appuser:appuser /app/auth_server /app/auth_server
COPY --from=backend-builder --chown=appuser:appuser /app/api /app/api
COPY --from=backend-builder --chown=appuser:appuser /app/config /app/config
COPY --from=backend-builder --chown=appuser:appuser /app/scripts /app/scripts
COPY --from=backend-builder --chown=appuser:appuser /app/cli/examples /app/cli/examples
COPY --from=backend-builder --chown=appuser:appuser /app/alembic.ini /app/alembic.ini
COPY --from=backend-builder --chown=appuser:appuser /app/alembic /app/alembic
COPY --from=backend-builder --chown=appuser:appuser /app/migrations/postgres /app/migrations/postgres

COPY --from=frontend-builder --chown=appuser:appuser /app/frontend/build /app/frontend/build

RUN mkdir -p /app/logs && \
    mkdir -p /app/certs && \
    mkdir -p /app/security_scans /app/skill_security_scans /app/agent_security_scans && \
    mkdir -p /etc/nginx/lua/virtual_mappings && \
    rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default && \
    mkdir -p /var/lib/nginx/body /var/lib/nginx/proxy /var/lib/nginx/fastcgi /var/lib/nginx/uwsgi /var/lib/nginx/scgi && \
    mkdir -p /var/log/nginx && \
    mkdir -p /run/nginx && \
    chown -R appuser:appuser /app/logs /app/certs /app/security_scans /app/skill_security_scans /app/agent_security_scans /etc/nginx /var/log/nginx /var/lib/nginx /run/nginx

EXPOSE 8080 8443 7860

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:7860/health || exit 1

ARG BUILD_VERSION="1.0.0"
ENV BUILD_VERSION=$BUILD_VERSION \
    STORAGE_BACKEND=postgres

USER appuser

ENTRYPOINT ["/app/registry-entrypoint.sh"]
